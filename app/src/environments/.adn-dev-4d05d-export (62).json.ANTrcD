      "termsPage": {
        "back": "Zurück",
        "eyebrow": "Rechtliches Dokument",
        "intro": "Diese Allgemeinen Geschäftsbedingungen definieren die rechtlichen Regeln für Buchungen und Ausflüge an Bord von Alegria. Der praktische Buchungsprozess wird auf einer separaten Seite beschrieben.",
        "print": "Drucken",
        "sections": [
          {
            "paragraphs": [
              "These Terms & Conditions govern the services offered by Alegria Boat for private outings at sea."
            ],
            "title": "1. Purpose"
          },
          {
            "paragraphs": [
              "The safety of passengers, crew and boat is the priority. The skipper may modify, postpone or cancel an outing if weather, sea or operational conditions require it."
            ],
            "title": "2. Safety and skipper decision"
          },
          {
            "paragraphs": [
              "Amounts due, deposits, balances, skipper fees and options are stated in the offer or confirmed booking. Payments must be made according to the terms set out in the offer."
            ],
            "title": "3. Payments"
          },
          {
            "paragraphs": [
              "A warranty may be required before the outing. If no damage is found after the outing, it is released. If damage is caused by passengers, Alegria may retain or charge an amount corresponding to the damage."
            ],
            "title": "4. Warranty and damage"
          },
          {
            "paragraphs": [
              "Any change or cancellation is handled according to the conditions specified in the accepted offer and these Terms & Conditions."
            ],
            "title": "5. Changes or cancellation"
          },
          {
            "paragraphs": [
              "Passengers must respect safety instructions, the boat, crew, equipment and marine environment."
            ],
            "title": "6. Passenger responsibility"
          },
          {
            "paragraphs": [
              "Personal data is used to manage the booking, payment and customer relationship. Payments and card registrations may be processed by secure providers such as Stripe."
            ],
            "title": "7. Personal data and secure payment"
          },
          {
            "paragraphs": [
              "These Terms & Conditions are governed by French law."
            ],
            "title": "8. Applicable law"
          }
        ],
        "title": "Allgemeine Geschäftsbedingungen",
        "updated": "July 2026",
        "updatedLabel": "Zuletzt aktualisiert"
      }
    },
