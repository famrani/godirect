        "channels": [
          {
            "cta": "Contact us",
            "icon": "📞",
            "link": "/contact",
            "text": "You can call us to discuss your plans, preferred date, number of guests and type of outing.",
            "title": "Call us"
          },
          {
            "cta": "Send a request",
            "icon": "✉️",
            "link": "/contact",
            "text": "You can send your request by email. We will come back to you with the relevant information.",
            "title": "Send an email"
          },
          {
            "cta": "Make a request",
            "icon": "📝",
            "link": "/reserver",
            "text": "You can create a offer request directly on the website by selecting the outing, date and passengers.",
            "title": "Request online"
          }
        ],
        "channelsTitle": "Three ways to get started",
        "eyebrow": "How it works",
        "finalNote": "The Terms & Conditions remain the legal reference document. This page only explains the practical booking journey.",
        "intro": "Discover each step of your Alegria experience, from your first request to your feedback after the outing.",
        "steps": [
          {
            "text": "The customer may call us, send an email or create an online offer request.",
            "title": "1. Initial request"
          },
          {
            "text": "Alegria reviews the request, checks feasibility, availability, the desired programme and applicable conditions.",
            "title": "2. Review by Alegria"
          },
          {
            "text": "Alegria sends a booking offer with prices, conditions, payment terms and outing details.",
            "title": "3. Offer / offer"
          },
          {
            "bullets": [
              "accept the Terms & Conditions;",
              "pay the required deposit;",
              "register a credit card for the warranty."
            ],
            "text": "The customer reviews the offer. To accept it, the customer must:",
            "title": "4. Customer review"
          },
          {
            "text": "Once these steps are completed, the booking is confirmed. The customer can then view the booking from the customer area.",
            "title": "5. Booking confirmed"
          },
          {
            "text": "The customer may request a change or cancellation under the conditions defined in the Terms & Conditions.",
            "title": "6. Change or cancellation"
          },
          {
            "text": "On or before the day of the outing, the customer pays the remaining amounts due, including the boat balance, skipper or optional services.",
            "title": "7. Remaining payments"
          },
          {
            "text": "At the end of the outing, the warranty amount is released if no damage was caused by passengers. If damage occurs, Alegria may charge an amount to cover the damage caused.",
            "title": "8. Warranty after the outing"
          },
          {
            "text": "After the outing, the customer may leave a review and suggest how Alegria could improve.",
            "title": "9. Customer feedback"
          }
        ],
